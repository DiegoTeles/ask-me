# ─── Neon / Vercel Storage ───────────────────────────────────────────────────

# Recommended for most uses (pooled via PgBouncer)
DATABASE_URL=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.c-8.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Direct connection (sem pooler — use para migrações/scripts)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:SENHA@ep-xxxx.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require

# Parâmetros individuais de conexão
PGHOST=ep-xxxx-pooler.c-8.us-east-1.aws.neon.tech
PGHOST_UNPOOLED=ep-xxxx.c-8.us-east-1.aws.neon.tech
PGUSER=neondb_owner
PGDATABASE=neondb
PGPASSWORD=SENHA

# Aliases para templates Vercel Postgres
POSTGRES_URL=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.c-8.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:SENHA@ep-xxxx.c-8.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
POSTGRES_URL_NO_SSL=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.c-8.us-east-1.aws.neon.tech/neondb
POSTGRES_PRISMA_URL=postgresql://neondb_owner:SENHA@ep-xxxx-pooler.c-8.us-east-1.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_HOST=ep-xxxx-pooler.c-8.us-east-1.aws.neon.tech
POSTGRES_PASSWORD=SENHA
POSTGRES_DATABASE=neondb

# ─── Aplicação ────────────────────────────────────────────────────────────────

# Segredo para assinar tokens JWT de sessão (string longa e aleatória)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Senha do painel /admin legado
ADMIN_SECRET=troque-por-uma-senha-forte

# URL pública da aplicação (sem barra no final)
NEXT_PUBLIC_APP_URL=http://localhost:3000
